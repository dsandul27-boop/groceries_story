<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  groceries_story Checkstyle ruleset.

  Intentionally focused on high-signal, low-noise correctness/hygiene rules rather
  than exhaustive formatting. The goal is to catch the classes of defect that keep
  slipping through review (accidental imports, unused imports, dead/scratch code,
  non-English comments) automatically, so reviews can focus on logic & design.

  Scope: production code only (src/main/java). Test sources are not checked yet
  (see pom: includeTestSourceDirectory=false) because the test suite leans on
  static star-imports; tighten later if desired.
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="charset" value="UTF-8"/>
    <property name="fileExtensions" value="java"/>

    <!-- No trailing whitespace. -->
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="message" value="Line has trailing whitespace."/>
    </module>

    <module name="TreeWalker">

        <!-- No non-ASCII characters in source (catches leftover non-English comments). -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="[^\x00-\x7F]"/>
            <property name="message" value="Non-ASCII character found; keep source and comments in English/ASCII."/>
            <property name="ignoreComments" value="false"/>
        </module>

        <!-- Imports: the big win for this codebase. -->
        <module name="UnusedImports">
            <property name="processJavadoc" value="true"/>
        </module>
        <module name="RedundantImport"/>
        <!-- Ban accidental / wrong imports: the Hibernate dialect that slipped in,
             plus JDK-internal packages commonly mis-auto-imported by the IDE. -->
        <module name="IllegalImport">
            <property name="illegalPkgs" value="sun, org.hibernate.dialect, jdk, org.antlr"/>
        </module>
        <!-- NOTE: AvoidStarImport intentionally omitted for v1 (jakarta.persistence.* etc.
             are widely accepted); enable later once the codebase is converted. -->

        <!-- Dead / sloppy code. -->
        <module name="EmptyStatement"/>
        <module name="OneTopLevelClass"/>
        <module name="UpperEll"/>
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>

        <!-- Braces always, even for one-line bodies. -->
        <module name="NeedBraces"/>
    </module>
</module>
